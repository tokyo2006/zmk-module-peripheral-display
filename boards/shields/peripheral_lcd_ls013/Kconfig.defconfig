if SHIELD_PERIPHERAL_LCD_LS013

config ZMK_PERIPHERAL_DISPLAY
    default y

# Use our custom screen
choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

config ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    select LV_USE_LABEL
    select LV_USE_BAR
    select LV_USE_ARC
    select LV_USE_IMAGE
    select LV_USE_ANIMIMG
    select LV_USE_ANIMATION
    select LVGL
    select LV_FONT_UNSCII_8
    select LV_FONT_UNSCII_16

# LVGL mono color depth
choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

config LV_Z_MEM_POOL_SIZE
    default 32768

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

# Force a full framebuffer flush every frame. Without it LVGL uses
# partial (dirty-rect) updates, which leave the Sharp memory LCD with
# regions stuck in different VCOM states (some black, some white, some
# gray). Idle cost is low: the bongo-cat idle animation only ticks every
# 10 s, so the panel redraws roughly once per 10 s at rest.
config LV_Z_FULL_REFRESH
    default y

endif
